{
  "name": "kdtu-app",
  "version": "0.1.0",
  "private": true,
  "description": "KDTU timetable + KDL management monorepo (kdtu + kdtu-admin + Express API + SQLCipher)",
  "type": "module",
  "workspaces": [
    "server",
    "kdtu",
    "kdtu-admin",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=kdtu && npm run build --workspace=kdtu-admin",
    "test": "npm run test --workspaces --if-present",
    "server:dev": "npm run dev --workspace=server",
    "server:start": "npm run start --workspace=server",
    "server:seed": "npm run seed --workspace=server",
    "kdtu:dev": "npm run dev --workspace=kdtu",
    "kdtu-admin:dev": "npm run dev --workspace=kdtu-admin"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7"
  }
}
