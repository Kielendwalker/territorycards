# KDTU server secrets — DO NOT COMMIT .env
# Copy to .env and fill in real values. .env is git-ignored.

# SQLCipher passphrase for the SQLite database file.
# Must be >= 32 characters. Passed straight to SQLCipher via PRAGMA key.
KDTU_DB_KEY=

# Field-encryption passphrase (member names, phone numbers).
# Hashed with SHA-256 to a 32-byte AES-256 key. Must be >= 32 characters.
KDTU_FIELD_KEY=

# JWT signing secret for admin auth.
KDTU_JWT_SECRET=